 static uint32_t SDMMC_GetCmdError(SDMMC_TypeDef *SDMMCx);
 
+/* Rev D local adaptation: keep CAN ingestion alive during command-response
+ * waits as well as the SD data-DMA wait. No protocol parsing is changed.
+ * Thread context keeps the upstream millisecond deadline in real elapsed time;
+ * SDMMC ISR context never enters application code and limits command-response
+ * polling to 1 ms using the independent 1 MHz TIM2 clock. CMD12 here requests
+ * SDMMC_RESPONSE_SHORT (R1), not a card-programming/busy-D0 wait.
+ * Patch provenance: third_party/patches/STM32H7_SDMMC_cooperative_manifest.json */
+#if defined(CANFD_REVD_TARGET)
+extern void revd_sdmmc_cmd_wait_poll(void);
+typedef struct
+{
+  uint32_t started_ms, started_us, iterations, timeout_ms, irq;
+} revd_sdmmc_wait_t;
+static revd_sdmmc_wait_t revd_sdmmc_wait_begin(uint32_t timeout_ms)
+{
+  revd_sdmmc_wait_t wait = {0};
+  wait.irq = __get_IPSR();
+  wait.timeout_ms = timeout_ms;
+  wait.started_ms = HAL_GetTick();
+  if (wait.irq != 0U) wait.started_us = TIM2->CNT;
+  return wait;
+}
+static uint32_t revd_sdmmc_wait_expired(revd_sdmmc_wait_t *wait)
+{
+  if ((++wait->iterations & 255U) != 0U) return 0U;
+  if (wait->irq != 0U)
+  {
+    /* SysTick can have lower priority than SDMMC, so it cannot time this ISR. */
+    return (uint32_t)(TIM2->CNT - wait->started_us) >= 1000U;
+  }
+  revd_sdmmc_cmd_wait_poll();
+  return (uint32_t)(HAL_GetTick() - wait->started_ms) >= wait->timeout_ms;
+}
+#define REVD_SDMMC_WAIT_BEGIN(timeout) revd_sdmmc_wait_t revd_wait = revd_sdmmc_wait_begin(timeout)
+#define REVD_SDMMC_WAIT_POLL() do { if (revd_sdmmc_wait_expired(&revd_wait)) return SDMMC_ERROR_TIMEOUT; } while (0)
+#else
+#define REVD_SDMMC_WAIT_BEGIN(timeout)
+#define REVD_SDMMC_WAIT_POLL()
+#endif
+
