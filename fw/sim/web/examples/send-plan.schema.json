{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAN FD发送方案 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "channel_mask",
    "channels"
  ],
  "properties": {
    "format": {
      "const": "canfd-send-plan"
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 256
    },
    "channel_mask": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/channel"
      }
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 47,
      "pattern": "^(?! )(?!\\.\\.?$)[^/\\\\\\u0000-\\u001F\\u007F-\\u009F]*[^ /\\\\\\u0000-\\u001F\\u007F-\\u009F]$",
      "description": "可选项目分组名，最多47个UTF-8字节（运行时另作字节长度校验）；不可含路径/控制字符或首尾空格。省略时显示未分组。"
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "id",
        "extended",
        "fd",
        "brs",
        "rtr",
        "length",
        "data",
        "period_ms",
        "enabled",
        "repeat_count",
        "frame_gap_ms",
        "cycle_ms",
        "dynamic"
      ],
      "properties": {
        "extended": {
          "type": "boolean"
        },
        "fd": {
          "type": "boolean"
        },
        "brs": {
          "type": "boolean"
        },
        "rtr": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "id": {
          "type": "string",
          "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
          "description": "十六进制字符串；标准ID≤7FF，扩展ID≤1FFFFFFF"
        },
        "length": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            12,
            16,
            20,
            24,
            32,
            48,
            64
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 192,
          "description": "完整十六进制字节，字节数必须匹配length；RTR留空"
        },
        "period_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "frame_gap_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "cycle_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "description": "必须大于 (repeat_count-1)×frame_gap_ms"
        },
        "dynamic": {
          "$ref": "#/definitions/dynamic"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fd": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "brs": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rtr": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "fd": {
                "const": false
              },
              "data": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "dynamic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counter_byte",
        "counter_bits",
        "counter_max",
        "counter_next",
        "checksum",
        "checksum_byte",
        "checksum_from",
        "checksum_to"
      ],
      "properties": {
        "counter_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "counter_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "counter_next": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "checksum_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "checksum_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "checksum_to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "counter_bits": {
          "enum": [
            0,
            4,
            8
          ]
        },
        "checksum": {
          "enum": [
            "none",
            "xor",
            "sum",
            "crc8-j1850",
            "crc8-h2f"
          ]
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "id_gap_ms",
        "entries"
      ],
      "properties": {
        "channel": {
          "enum": [
            1,
            2
          ]
        },
        "id_gap_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "entries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/entry"
          }
        }
      }
    }
  }
}
